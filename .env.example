BACKEND_API_URL=https://inference.api.libertai.io
BACKEND_SECRET_TOKEN=__ADMIN__SECRET__TOKEN__
MODELS_CONFIG=/data/models.json

# Telegram alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=

# -- Logging --
LOG_LEVEL=DEBUG

PRIVATE_KEY=

# x402
X402_API_KEY=
X402_SERVER_WALLET_ADDRESS=
X402_WALLET_ADDRESS=
THIRDWEB_SECRET_KEY=
THIRDWEB_VAULT_ACCESS_TOKEN=

PUBLIC_BASE_URL=https://api.libertai.io

# Aleph credits
ALEPH_SENDER_PRIVATE_KEY=

# Redis (shared state for multi-container deployments)
REDIS_URL=redis://redis:6379/0

# Search service
SEARCH_SERVICE_URL=https://search.libertai.io

# Free-tier admission gate (src/proxy.py): aggregate inflight requests across the
# requested model's servers. At FREE_SOFT_LOAD free-tier keys wait (bounded) for
# the pool to drain; at FREE_HARD_LOAD they are rejected outright. Paid tiers
# bypass. Values must satisfy 0 < FREE_SOFT_LOAD <= FREE_HARD_LOAD (violations
# log a warning at startup). Tune against real load data; raise both thresholds
# to disable the gate (a high FREE_HARD_LOAD alone only removes the rejection).
FREE_SOFT_LOAD=25
FREE_HARD_LOAD=50

# Uvicorn worker processes (uvicorn reads this natively). Parallel CPU cores and
# per-worker connection pools/limits; --limit-concurrency in the Dockerfile is
# per worker. 1 keeps the previous single-process behavior.
WEB_CONCURRENCY=1
